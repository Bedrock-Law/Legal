flowchart TD
  subgraph F0["Antes del lanzamiento, una sola vez"]
    PR4["Contratos firmados con Coopcentral y con el emisor · convenio de afiliación con cada operador · política de datos publicada · oficial designado · piezas y avisos aprobados"]
  end
  subgraph F1["Fase 1. Oferta y vinculación"]
    A["Cliente solicita CREDIX1"] --> B["Oferta: costos del Anexo 1, avisos de vinculación y modalidades de control"]
    B --> C["Debida diligencia, capítulo 2"]
    C --> C1{"¿Aprueba?"}
    C1 -- No --> Z1["No se vincula"]
    C1 -- Sí --> D["Cliente marca las casillas y firma contrato, pagaré y adhesión"]
  end
  subgraph F2["Fase 2. Garantía"]
    E["Cliente deposita en su cuenta de Coopcentral el monto que respalda el cupo"] --> E2{"Modalidad"}
    E2 -- Absoluto --> F1N["Se inmoviliza el 100% del depósito"]
    E2 -- Dinámico --> F2N["Se inmoviliza el saldo utilizado más el colchón"]
    F1N --> G["Coopcentral deja constancia de recibo de la adhesión y aplica el control"]
    F2N --> G
    G --> G2["EHOLDINGS inscribe la garantía en el Registro de Garantías Mobiliarias"]
  end
  subgraph F3["Fase 3. Activación"]
    H["EHOLDINGS confirma al emisor y este expide la tarjeta con el cupo"]
  end
  subgraph F4["Fase 4. Uso"]
    J["Cliente compra con la tarjeta"] --> K["Cierre del extracto mensual"]
    J -. Disputa .-> J2["Trámite de la disputa: el monto no cuenta como mora"]
    J -. Retracto .-> RT["Dentro de 5 días hábiles si la vinculación fue digital o a distancia: se cancela el cupo y se libera toda la garantía, sin reporte ni penalidad"]
    K --> L{"¿Paga a tiempo?"}
    L -- Sí --> M["Reporte positivo al operador; sigue el uso"]
    L -- No --> N["Pasa a la fase 5, diagrama 2"]
  end
  PR4 --> A
  D --> E
  G2 --> H
  H --> J
