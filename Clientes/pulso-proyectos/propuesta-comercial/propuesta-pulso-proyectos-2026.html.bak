<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Propuesta Pulso Proyectos</title>
<meta name="description" content="Estructura legal para captación pre-fiducia de dos proyectos inmobiliarios.">
<style>
:root{
  --primario:#1B1D36;
  --secundario:#224D6E;
  --acento:#E9CDA5;
  --texto:#000000;
  --fondo:#FFFFFF;
  --gris:#6B6F7A;
  --linea:#E2E6EB;
  --tenue:#F7F8FA;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,Roboto,sans-serif;
  --serif:Tinos,Georgia,"Times New Roman",serif;
  --maxw:1080px;
  --r:4px;
  --logo-oscuro:url(data:image/svg+xml;utf8,<svg viewBox="0 0 120 60" xmlns="http://www.w3.org/2000/svg"><rect width="120" height="60" fill="%23E9CDA5"/><text x="60" y="40" font-family="Georgia,serif" font-size="28" font-weight="bold" text-anchor="middle" fill="%231B1D36">BEDROCK</text></svg>);
  --logo-claro:url(data:image/svg+xml;utf8,<svg viewBox="0 0 120 60" xmlns="http://www.w3.org/2000/svg"><rect width="120" height="60" fill="%23FFFFFF"/><text x="60" y="40" font-family="Georgia,serif" font-size="28" font-weight="bold" text-anchor="middle" fill="%231B1D36">BEDROCK</text></svg>);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--serif);background:var(--fondo);color:var(--texto);line-height:1.75;font-size:16px}
h1,h2,h3,h4,h5,h6{font-family:var(--sans);font-weight:600;letter-spacing:-0.01em}
h1{font-size:2.8rem;line-height:1.1;margin-bottom:1.5rem}
h2{font-size:2rem;line-height:1.2;margin-bottom:1.5rem}
h3{font-size:1.2rem;line-height:1.3;font-weight:600;margin-bottom:1rem}
a{color:var(--secundario);text-decoration:none;transition:color 0.2s}
a:hover{color:var(--primario)}
table{width:100%;border-collapse:collapse;margin:1.5rem 0}
table thead{background:var(--primario);color:var(--fondo)}
table th{padding:1rem;text-align:left;font-weight:600;font-size:0.9rem}
table td{padding:1rem;border-bottom:1px solid var(--linea)}
table tr:hover{background:var(--tenue)}
table .der{text-align:right}
table .total{background:var(--tenue);font-weight:600}
.btn{display:inline-block;padding:0.75rem 1.5rem;border-radius:var(--r);font-family:var(--sans);font-size:0.9rem;font-weight:600;text-decoration:none;cursor:pointer;border:none;transition:all 0.2s}
.btn.sobre-oscuro{background:var(--primario);color:var(--fondo)}
.btn.sobre-oscuro:hover{background:var(--secundario)}
.btn.fantasma{background:transparent;color:var(--primario);border:2px solid var(--primario)}
.btn.fantasma:hover{border-color:var(--acento);color:var(--acento)}
#progreso{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--acento),var(--secundario));z-index:1000;width:0}
header{background:var(--fondo);border-bottom:1px solid var(--linea);position:sticky;top:0;z-index:100}
.barra{display:flex;justify-content:space-between;align-items:center;max-width:var(--maxw);margin:0 auto;padding:1rem 3rem;gap:2rem}
.logo{width:80px;height:40px;background-size:contain;background-repeat:no-repeat;background-position:center}
.logo-oscuro{background-image:var(--logo-oscuro)}
.logo-claro{background-image:var(--logo-claro)}
#menu-movil{display:none;background:none;border:none;cursor:pointer;color:var(--primario);padding:0.5rem}
nav{display:flex;gap:1.5rem;align-items:center}
nav a{font-size:0.9rem;font-weight:500;font-family:var(--sans);color:var(--primario);border-bottom:2px solid transparent;padding-bottom:0.25rem;transition:border-color 0.2s}
nav a:hover{border-bottom-color:var(--acento)}
.hero{background:linear-gradient(135deg,var(--tenue) 0%,var(--fondo) 100%);padding:4rem 3rem;text-align:center}
.hero-in{max-width:var(--maxw);margin:0 auto}
.eyebrow{font-family:var(--sans);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--gris);margin-bottom:1.5rem}
.regla-hero{width:60px;height:3px;background:var(--acento);margin:2rem auto}
.lede{font-size:1.2rem;line-height:1.6;color:var(--gris);margin-bottom:2rem;max-width:800px;margin-left:auto;margin-right:auto}
.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:2rem;margin:2rem 0;text-align:center}
.meta div{display:flex;flex-direction:column}
.meta dt{font-family:var(--sans);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--gris);margin-bottom:0.5rem}
.meta dd{font-size:2rem;font-weight:700;color:var(--primario);line-height:1.2}
.meta small{display:block;font-size:0.8rem;font-weight:400;color:var(--gris);margin-top:0.25rem;text-transform:none;letter-spacing:normal}
.destinatario{font-size:0.9rem;color:var(--gris);font-style:italic;margin-top:2rem}
.acciones{display:flex;justify-content:center;gap:1rem;margin-top:2rem;flex-wrap:wrap}
section{max-width:var(--maxw);margin:0 auto;padding:4rem 3rem;border-bottom:1px solid var(--linea)}
section.alterna{background:var(--tenue)}
.in{max-width:100%;margin:0}
.num{font-family:var(--sans);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--gris);margin-bottom:1rem}
.regla{width:60px;height:2px;background:var(--acento);margin:1.5rem 0}
.intro{font-size:1.05rem;line-height:1.8;margin-bottom:1.5rem;color:var(--texto)}
.etiqueta{font-family:var(--sans);font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--gris);margin-bottom:0.5rem}
.nota{background:var(--tenue);border-left:4px solid var(--acento);padding:1.5rem;margin:2rem 0;border-radius:var(--r)}
.nota b{color:var(--primario);font-weight:700}
.rejilla{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem;margin:2rem 0}
.rejilla.r2{grid-template-columns:repeat(2,1fr)}
.rejilla.par > *:nth-child(even){background:var(--tenue)}
.rejilla.rev > *{background:var(--fondo);border:1px solid var(--linea)}.rejilla.rev.par > *:nth-child(even){background:var(--tenue)}
.tarjeta{padding:2rem;border-radius:var(--r);position:relative}
.tarjeta .ico{font-family:var(--sans);font-size:2.5rem;font-weight:700;color:var(--acento);margin-bottom:1rem;line-height:1}
.tarjeta h3{margin-bottom:0.75rem}
.tarjeta p{color:var(--gris);line-height:1.7}
.tabla-envoltura{overflow-x:auto;margin:1.5rem 0}
.tabla-envoltura table{margin:0}
footer{background:var(--primario);color:var(--fondo);padding:3rem}
.pie{max-width:var(--maxw);margin:0 auto;text-align:center}
.pie > div{margin:0.75rem 0;font-family:var(--sans);font-size:0.9rem}
.pie a{color:var(--acento)}
.pie a:hover{color:var(--fondo)}
.reserva{font-size:0.8rem;color:rgba(255,255,255,0.7);margin-top:1.5rem;margin-bottom:0}
.cierre{padding:4rem 3rem;text-align:center;background:var(--tenue)}
.hechos{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem;margin:2rem 0;text-align:left}
.hechos > div{background:var(--fondo);padding:1.5rem;border-radius:var(--r);border:1px solid var(--linea)}
.espacio{height:1rem}
@media(max-width:768px){
  .barra{padding:1rem 1.5rem;flex-wrap:wrap}
  #menu-movil{display:block}
  nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:var(--fondo);border-bottom:1px solid var(--linea);padding:1rem;gap:0}
  nav.abierta{display:flex}
  nav a{width:100%;padding:0.75rem 0;border-bottom:none}
  h1{font-size:1.75rem}
  h2{font-size:1.4rem}
  section{padding:2rem 1.5rem}
  .hero{padding:2rem 1.5rem}
  .meta{grid-template-columns:1fr;gap:1.5rem}
  .meta dd{font-size:1.5rem}
  .rejilla.r2{grid-template-columns:1fr}
  .hechos{grid-template-columns:1fr}
  .acciones{flex-direction:column}
  .acciones .btn{width:100%}
}
</style>
</head>
<body>
<div id="progreso" aria-hidden="true"></div>

<header>
  <div class="barra">
    <span class="logo logo-oscuro" role="img" aria-label="Bedrock Abogados"></span>
    <button id="menu-movil" aria-label="Abrir menú de secciones" aria-expanded="false" aria-controls="nav">
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
    <nav id="nav" aria-label="Secciones del documento">
      <a href="#seccion-1">Problema</a>
      <a href="#seccion-2">Solución</a>
      <a href="#seccion-3">Alcance</a>
      <a href="#seccion-4">Honorarios</a>
      <a class="btn sobre-oscuro" href="#cierre">Confirmar</a>
    </nav>
  </div>
</header>

<div class="hero">
  <div class="hero-in">
    <span class="logo logo-claro" role="img" aria-label="Bedrock Abogados"></span>
    <p class="eyebrow">Propuesta de servicios profesionales · Ref. BED-PULSO-2026-01</p>
    <h1>Estructura legal para captación pre-fiducia</h1>
    <div class="regla-hero"></div>
    <p class="lede">Concepto jurídico y documentos operativos para viabilizar la recaudación de capital antes de la constitución de la fiducia, con una estrategia replicable para futuros proyectos.</p>
    <dl class="meta">
      <div><dt>Proyectos</dt><dd>2<small>La Estrella y Cartagena</small></dd></div>
      <div><dt>Documentos</dt><dd>2<small>Mandato específico + promesa de adhesión</small></dd></div>
      <div><dt>Inversión</dt><dd>6 SMLMV<small>más IVA 19%</small></dd></div>
      <div><dt>Vigencia</dt><dd>12 días<small>hasta el 21 de sept. 2026</small></dd></div>
    </dl>
    <p class="destinatario">Para Pulso Proyectos Temáticos S.A.S. · De Bedrock Abogados · 9 de septiembre de 2026</p>
    <div class="acciones">
      <a class="btn sobre-oscuro" href="#seccion-2">Ver la solución</a>
      <a class="btn fantasma" href="#seccion-4">Ver honorarios</a>
    </div>
  </div>
</div>

<section id="seccion-1">
  <div class="in">
    <p class="num">01 · Problema</p>
    <h2>La captación pre-fiducia está regulada</h2>
    <div class="regla"></div>
    <p class="intro">Pulso Proyectos va a lanzar dos proyectos inmobiliarios (La Estrella y Cartagena) con campaña de expectativa en la feria del 25-27 de septiembre. Antes de constituir la fiducia, necesita recaudar dinero de inversionistas como "lista cero" — aportes en cantidad suficiente (25-50 personas × $1.000.000 cada una) con compromiso de adhesión futura al esquema fiduciario. La normativa de captación del público limita las herramientas disponibles.</p>
    <div class="rejilla r2 par rev">
      <div class="tarjeta"><div class="ico" aria-hidden="true">1</div><h3>Límite de mandatos</h3><p>Máximo 20 contratos de mandato de libre administración en 3 meses. A escala de dos proyectos con decenas de inversionistas, es insuficiente.</p></div>
      <div class="tarjeta"><div class="ico" aria-hidden="true">2</div><h3>Falta de documentación</h3><p>Recibir dinero sin respaldo contractual genera riesgo reputacional, exposición regulatoria y conflicto potencial con los inversionistas.</p></div>
      <div class="tarjeta"><div class="ico" aria-hidden="true">3</div><h3>Timeline acotado</h3><p>La feria es en 15 días. Se necesita concepto y documentos listos para el martes 21 de septiembre.</p></div>
      <div class="tarjeta"><div class="ico" aria-hidden="true">4</div><h3>Solución futura</h3><p>Estos documentos deben servir a Pulso para todos los proyectos que lance. No puede precisar abogado cada que haga una feria.</p></div>
    </div>
  </div>
</section>

<section id="seccion-2" class="alterna">
  <div class="in">
    <p class="num">02 · Solución</p>
    <h2>Mandatos específicos y promesas de inversión</h2>
    <div class="regla"></div>
    <p class="intro">La modalidad propuesta es <strong>mandatos específicos</strong> como herramienta de captación. A diferencia del mandato de libre administración, el mandato específico especifica el destino exacto de los fondos — la constitución futura de la fiducia y la adhesión al encargo fiduciario — y no carga contra el límite regulatorio porque el riesgo es predeterminado y controlado.</p>

    <h3 style="margin-top:36px">Modalidades disponibles</h3>
    <div class="espacio"></div>
    <div class="tabla-envoltura rev" tabindex="0" role="region" aria-label="Modalidades jurídicas disponibles">
      <table>
        <thead><tr><th scope="col">Modalidad</th><th scope="col">Características</th></tr></thead>
        <tbody>
          <tr><th scope="row">Mandato específico</th><td>Se entrega plata para transferencia a fiducia futura. No limita cantidad de personas. Sustento normativo probado en el mercado de proptech y real estate.</td></tr>
          <tr><th scope="row">Promesa de inversión</th><td>El inversionista compra el derecho a una inversión futura. Salida del espacio de captación por compraventa de derechos.</td></tr>
          <tr><th scope="row">Promesa de adhesión</th><td>El inversionista promete hoy adherirse al contrato de adhesión fiduciaria. Vincula la voluntad antes de la vinculación formal.</td></tr>
        </tbody>
      </table>
    </div>
    <p style="margin-top:16px;font-size:13.5px;color:var(--gris)">La modalidad final se define en la primera ronda de comentarios tras recibir el concepto jurídico. Bedrock recomienda el mandato específico como la más robusta regulatoriamente.</p>

    <div class="nota rev"><b>Arquitectura operativa.</b> El inversionista firma, aporta $1.000.000, el dinero queda en hold en cuenta dedicada de Pulso. Una vez constituida la fiducia y aprobado por Pulso, se contacta al inversionista para vincularlo mediante contrato de adhesión fiduciaria. El dinero se transfiere de Pulso a la fiducia como aporte del adherente.</div>
  </div>
</section>

<section id="seccion-3">
  <div class="in">
    <p class="num">03 · Alcance</p>
    <h2>Concepto, documentos y acompañamiento</h2>
    <div class="regla"></div>
    <p class="intro">Bedrock entrega un concepto jurídico de 3-5 páginas que explica la viabilidad normativa, cita la regulación de captación, señala riesgos residuales y sus mitigantes. Además, dos documentos operativos listos para usar en la feria: un mandato específico (4-5 páginas) y una promesa de adhesión (alternativa). Ambos con ajustes para La Estrella y Cartagena.</p>

    <h3 style="margin-top:36px">Documentos entregables</h3>
    <div class="espacio"></div>
    <div class="tabla-envoltura rev" tabindex="0" role="region" aria-label="Documentos entregables del proyecto">
      <table>
        <thead><tr><th scope="col">Entregable</th><th scope="col">Detalle</th></tr></thead>
        <tbody>
          <tr><th scope="row">Concepto jurídico</th><td>Análisis de viabilidad normativa, cita de la norma de captación, riesgos y mitigantes</td></tr>
          <tr><th scope="row">Mandato específico</th><td>Documento de captación con cláusulas de retención en hold y transferencia a fiducia</td></tr>
          <tr><th scope="row">Promesa de adhesión</th><td>Alternativa de captación con enfoque de promesa de derechos futuros</td></tr>
          <tr><th scope="row">Acompañamiento</th><td>Reunión de arranque, análisis del contrato actual, primera ronda de comentarios y ajustes</td></tr>
        </tbody>
      </table>
    </div>

    <p class="etiqueta" style="margin-top:44px">Lo que NO incluye</p>
    <p>Constitución de fiducia, tramitación regulatoria, servicios de depósito o cuenta dedicada, asesoría contable o tributaria.</p>

    <div class="nota rev"><b>Definición en primera ronda.</b> Tras recibir el concepto jurídico y el documento, Pulso y Bedrock definen conjuntamente la modalidad jurídica más robusta para la feria.</div>
  </div>
</section>

<section id="seccion-4" class="alterna">
  <div class="in">
    <p class="num">04 · Honorarios</p>
    <h2>Inversión y timeline</h2>
    <div class="regla"></div>
    <p class="intro">Los valores se expresan en salarios mínimos legales mensuales vigentes (SMLMV). El SMLMV para 2026 es $1.750.905, fijado por Decreto 1469 de 2025. Cada etapa se factura al cumplirse el hito correspondiente, más IVA a la tarifa aplicable.</p>

    <div class="tabla-envoltura rev" tabindex="0" role="region" aria-label="Honorarios consolidados en pesos">
      <table>
        <thead><tr><th scope="col">Etapa</th><th scope="col">SMLMV</th><th scope="col">Valor 2026</th></tr></thead>
        <tbody>
          <tr><th scope="row">Concepto jurídico (borrador)</th><td>2</td><td class="der">$3.501.810</td></tr>
          <tr><th scope="row">Documento equivalente a mandato</th><td>2</td><td class="der">$3.501.810</td></tr>
          <tr><th scope="row">Primera ronda de comentarios y ajustes</th><td>1</td><td class="der">$1.750.905</td></tr>
          <tr><th scope="row">Versión final y reunión de cierre</th><td>1</td><td class="der">$1.750.905</td></tr>
          <tr class="total"><th scope="row">TOTAL (6 SMLMV)</th><td colspan="2" class="der">$12.501.462 + IVA 19%</td></tr>
        </tbody>
      </table>
    </div>

    <h3 style="margin-top:44px">Forma de pago</h3>
    <div class="espacio"></div>
    <div class="tabla-envoltura rev" tabindex="0" role="region" aria-label="Forma de pago del proyecto">
      <table>
        <tbody>
          <tr><th scope="row">Al inicio del proyecto</th><td class="der">3 SMLMV + IVA = $6.250.732</td></tr>
          <tr><th scope="row">Al entrego de entregables finales (martes 21)</th><td class="der">3 SMLMV + IVA = $6.250.732</td></tr>
        </tbody>
      </table>
    </div>

    <h3 style="margin-top:44px">Timeline de ejecución</h3>
    <div class="espacio"></div>
    <div class="tabla-envoltura rev" tabindex="0" role="region" aria-label="Timeline del proyecto">
      <table>
        <tbody>
          <tr><th scope="row">Lunes 14 de septiembre</th><td>Revisión de contrato actual + Concepto jurídico (borrador) + Documento equivalente</td></tr>
          <tr><th scope="row">Martes 16-17 de septiembre</th><td>Primera ronda de comentarios y ajustes</td></tr>
          <tr><th scope="row">Martes 21 de septiembre</th><td>Concepto + documentos versión final + Reunión de cierre</td></tr>
          <tr><th scope="row">25-27 de septiembre</th><td>Feria — Pulso preparado</td></tr>
        </tbody>
      </table>
    </div>

    <p style="margin-top:16px;font-size:13.5px;color:var(--gris)">Esta propuesta es válida por doce días calendario desde su fecha de emisión, es decir, hasta el 21 de septiembre de 2026. Vencido ese plazo sin aceptación, los honorarios deben revisarse antes de cualquier confirmación, en particular si para entonces cambió el salario mínimo legal mensual vigente.</p>

    <div class="nota rev"><b>Análisis sujeto a documentación.</b> El concepto y los documentos se elaboraron sobre lo expuesto por Pulso Proyectos en la reunión del 9 de septiembre de 2026. El análisis definitivo se hace sobre la documentación que Pulso aporte: sus contratos de mandato actuales, actas de junta directiva, y cualquier regulación interna sobre captación de recursos.</div>
  </div>
</section>

<section class="cierre" id="cierre">
  <div class="in">
    <h2>La propuesta se ajusta con la documentación que aporte Pulso</h2>
    <div class="regla"></div>
    <div class="hechos">
      <div><b>Concepto jurídico.</b> Viabilidad normativa de captación pre-fiducia con mandatos específicos, promesas de inversión y promesas de adhesión.</div>
      <div><b>Vigencia.</b> Esta propuesta es válida hasta el 21 de septiembre de 2026.</div>
      <div><b>Entrega.</b> Lunes 14 a martes 21 de septiembre. Documentos listos para la feria del 25-27 de septiembre.</div>
    </div>
    <div class="acciones" style="justify-content:center">
      <a class="btn sobre-oscuro" href="mailto:tualiado@bedrock.com.co?subject=Propuesta%20Bedrock%20-%20Pulso%20Proyectos">Confirmar por correo</a>
    </div>
  </div>
</section>

<footer>
  <div class="pie">
    <span class="logo logo-claro" role="img" aria-label="Bedrock Abogados"></span>
    <div>Derecho para empresas en movimiento · Bogotá · Medellín</div>
    <div><a href="mailto:tualiado@bedrock.com.co">tualiado@bedrock.com.co</a> · <a href="https://www.bedrock.com.co">www.bedrock.com.co</a></div>
    <div class="reserva">Ref. BED-PULSO-2026-01 · Documento confidencial, de uso exclusivo de Pulso Proyectos Temáticos S.A.S. y de Bedrock.</div>
  </div>
</footer>

<script>
(function(){
  "use strict";
  var raiz = document.documentElement;
  raiz.classList.add("js");

  var barra = document.getElementById("progreso");
  function progreso(){
    var max = raiz.scrollHeight - raiz.clientHeight;
    barra.style.width = (max > 0 ? (raiz.scrollTop / max) * 100 : 0) + "%";
  }
  addEventListener("scroll", progreso, {passive:true});
  progreso();

  var bm = document.getElementById("menu-movil"), nav = document.getElementById("nav");
  function cerrarMenu(devolverFoco){
    nav.classList.remove("abierta");
    bm.setAttribute("aria-expanded","false");
    if(devolverFoco) bm.focus();
  }
  bm.addEventListener("click", function(){
    var abierta = nav.classList.toggle("abierta");
    bm.setAttribute("aria-expanded", abierta ? "true" : "false");
  });
  nav.addEventListener("click", function(e){
    if(e.target.tagName === "A") cerrarMenu(false);
  });
  addEventListener("keydown", function(e){
    if(e.key === "Escape") cerrarMenu(true);
  });
})();
</script>
</body>
</html>